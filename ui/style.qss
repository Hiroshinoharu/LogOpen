/* LogOpen / Signal Studio. Ink, mint, and warm priority accents.
   Controls retain readable type, native roles, and explicit keyboard focus.
   All dimensions are Qt logical pixels and scale with display DPI. */

/* Base surfaces and typography */
QDialog, QMenuBar, QMenu { background: #0d141f; color: #e5edf6; }
QStatusBar { background: #141f2d; color: #b2c1d4; border-top: 1px solid #263346; }
QPlainTextEdit, QTextEdit {
    background: #121e2c; color: #e5edf6;
    border: 2px solid #71869b; border-radius: 6px; padding: 8px;
    selection-background-color: #285d6c; selection-color: #ffffff;
    placeholder-text-color: #a5b3c6;
}
QPlainTextEdit:focus { border-color: #ffd166; }
QPushButton {
    background: #203244; color: #e5edf6; border: 2px solid #304258;
    border-radius: 10px; padding: 7px 12px;
}
QPushButton:hover { background: #2a4259; border-color: #7294ac; }
QPushButton:focus { border-color: #ffd166; }
QPushButton:disabled { background: #192636; color: #8998aa; border-color: #29394c; }
QMenuBar::item:selected, QMenu::item:selected { background: #285d6c; }
QMenu::item { padding: 8px 24px; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit {
    background: #141f2d; color: #e5edf6;
    border: 2px solid #71869b; border-radius: 6px; padding: 6px 8px;
    selection-background-color: #285d6c; selection-color: #ffffff;
    placeholder-text-color: #a5b3c6;
}
QComboBox QAbstractItemView { background: #141f2d; color: #e5edf6; selection-background-color: #285d6c; selection-color: #ffffff; }
QLineEdit:focus, QComboBox:focus { border-color: #ffd166; }
QTableWidget { background: #121e2c; color: #e5edf6; gridline-color: #29394c; selection-background-color: #285d6c; selection-color: #ffffff; }
QPushButton#comparisonButton {
    background: #142d30; color: #80e5d3; border: 2px solid #71869b;
    border-radius: 6px; padding: 7px; text-align: left;
}
QPushButton#comparisonButton:hover { background: #1a3a3c; }
QPushButton#comparisonButton:disabled { background: #141f2d; color: #a5b3c6; border-color: #263346; }
QProgressBar#scanProgress { background: #29394c; border: none; border-radius: 2px; }
QProgressBar#scanProgress::chunk { background: #63d8c4; border-radius: 2px; }
QWidget {
    color: #e5edf6;
    font-family: "Segoe UI";
    font-size: 15px;
}

QWidget#appSurface { background-color: #0d141f; }
QDialog#settingsDialog, QWidget#settingsContent, QScrollArea#settingsScroll {
    background-color: #0d141f;
}
QDialog#settingsDialog QLineEdit, QDialog#settingsDialog QSpinBox {
    background: #141f2d;
    border: 2px solid #71869b;
    border-radius: 7px;
    padding: 9px 12px;
    selection-background-color: #285d6c; selection-color: #ffffff;
}
QDialog#settingsDialog QLineEdit:focus, QDialog#settingsDialog QSpinBox:focus {
    border-color: #ffd166;
}
QDialog#settingsDialog QLineEdit:disabled, QDialog#settingsDialog QSpinBox:disabled {
    color: #8998aa;
}
QDialog#settingsDialog QCheckBox { spacing: 9px; padding: 5px 0; }
QDialog#settingsDialog QCheckBox::indicator { width: 20px; height: 20px; }
QLabel#settingsMessage { color: #ffbd95; font-size: 14px; }
QLabel#settingsMessage[success="true"] { color: #80e5d3; }
QFrame#modelCostCard {
    background: #142333;
    border: 2px solid #71869b;
    border-radius: 9px;
}
QLabel#modelCostTier { color: #afcaff; font-weight: 600; font-size: 14px; }
QLabel#modelCostTier[tier="Budget"] { color: #80e5d3; }
QLabel#modelCostTier[tier="Higher cost"], QLabel#modelCostTier[tier="Price unknown"] { color: #f4bc72; }
QLabel#modelCostHint { color: #afcaff; font-size: 14px; }
QLabel#modelCostHint[tier="Higher cost"], QLabel#modelCostHint[tier="Price unknown"] { color: #f4bc72; }
QLabel { background: transparent; }
QLabel#brandMark {
    background: #63d8c4;
    color: #0d302b;
    border-radius: 12px;
    font-size: 22px;
    font-weight: 700;
}
QLabel#brandTitle { font-size: 24px; font-weight: 700; letter-spacing: -1px; }
QFrame#divider { background-color: #233044; border: none; }
QLabel#pageTitle { font-size: 28px; font-weight: 700; letter-spacing: -1px; }
QLabel#subtitle { color: #a5b3c6; font-size: 15px; }
QLabel#mutedLabel { color: #a5b3c6; font-size: 14px; }

/* A distinctive scan workspace, with a calm illuminated surface. */
QFrame#scanHero {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #162231, stop: 0.65 #142333, stop: 1 #0d2832);
    border: 1px solid #304258;
    border-left: 4px solid #63d8c4;
    border-radius: 18px;
}
QLabel#heroEyebrow, QLabel#brandEyebrow, QLabel#emptyEyebrow {
    color: #80e5d3; font-size: 14px; font-weight: 600; letter-spacing: 2px;
}
QLabel#brandEyebrow { color: #a5b3c6; letter-spacing: 1px; }
QLabel#trustNote { color: #b2c1d4; font-size: 14px; }
QPushButton#headerButton {
    background: #141f2d; color: #c4d1e1; border: 2px solid transparent;
    border-radius: 10px; padding: 8px 12px; font-size: 14px; font-weight: 600;
}
QPushButton#headerButton:hover { background: #22374c; color: #edf3fa; }
QPushButton#headerButton:pressed { background: #172737; }
QPushButton#headerButton:focus { border-color: #ffd166; }
QPushButton#headerButton:disabled { color: #8998aa; background: #192636; }
QPushButton#headerButton[active="true"] { background: #15352f; color: #80e5d3; border-color: #285348; }
QPushButton#headerButton[active="true"]:focus { border-color: #ffd166; }
QFrame#monitoringStatus { background: #142d30; border: 1px solid #285348; border-left: 4px solid #63d8c4; border-radius: 12px; }
QFrame#monitoringStatus[tone="warning"] { background: #382f20; border-color: #645233; border-left-color: #ffd18a; }
QFrame#monitoringStatus[tone="error"] { background: #3a222d; border-color: #65404e; border-left-color: #ffadb7; }
QLabel#monitoringTitle { font-size: 16px; font-weight: 700; }
QLabel#monitoringDetail, QLabel#monitoringNotifications { color: #c4d1e1; font-size: 14px; }

/* A short, visible path through the first scan. */
QFrame#journeyStep {
    background: #141f2d; border: 1px solid #29394c; border-radius: 12px;
}
QFrame#journeyStep[current="true"] { background: #14312f; border-color: #4e9e90; }
QLabel#journeyNumber {
    background: #26384e; color: #d1deef; border-radius: 13px; font-weight: 700;
}
QFrame#journeyStep[current="true"] QLabel#journeyNumber { background: #63d8c4; color: #0b3029; }
QLabel#journeyTitle { color: #e5edf6; font-size: 15px; font-weight: 600; }
QLabel#journeyCaption { color: #a5b3c6; font-size: 14px; }
QFrame#disclosureSection { background: transparent; border: 2px solid #304258; border-radius: 12px; }
QPushButton#disclosureButton {
    text-align: left; padding: 11px 12px; border: 2px solid transparent; border-radius: 7px;
    background: #182636; color: #c5d3e4; font-weight: 600;
}
QPushButton#disclosureButton:hover { background: #22374c; }
QPushButton#disclosureButton:focus { border: 2px solid #ffd166; }
QPushButton#disclosureButton:disabled { color: #8998aa; }
QFrame#filterFeedback { background: #192e3b; border-radius: 8px; padding: 4px; }
QFrame#startHereCard { background: #142d30; border: 1px solid #285348; border-left: 4px solid #63d8c4; border-radius: 12px; }
QFrame#previewPanel { background: #141f2d; border: 1px solid #304258; border-radius: 12px; }
QPushButton#filterChip, QToolButton {
    background: #192636; color: #c5d3e4; border: 2px solid #304258;
    border-radius: 8px; padding: 3px 7px; font-size: 14px;
}
QPushButton#filterChip:hover, QToolButton:hover { background: #22374c; }
QPushButton#filterChip:focus, QToolButton:focus { border-color: #ffd166; }
QPushButton#metricCard:hover { background: #182636; }
QPushButton#metricCard:focus { border-color: #ffd166; }

/* Header status and result counts */
QLabel#stateBadge, QLabel#countBadge {
    background: #192636;
    color: #b2c1d4;
    border: 1px solid #2a3a4f;
    border-radius: 10px;
    padding: 7px 12px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0px;
}
QLabel#stateBadge[state="complete"] {
    color: #80e5d3;
    background: #15352f;
    border-color: #285348;
}
QLabel#stateBadge[state="scanning"] {
    color: #afcaff;
    background: #1b2b46;
    border-color: #344d72;
}
QLabel#stateBadge[state="warning"] {
    color: #ffd18a;
    background: #382f20;
    border-color: #645233;
}
QLabel#scanWarning {
    color: #ffd18a;
    background: #382f20;
    border: 1px solid #645233;
    border-radius: 6px;
    padding: 10px;
}
QLabel#stateBadge[state="error"] {
    color: #ffadb7;
    background: #3a222d;
    border-color: #65404e;
}

/* Primary action: keyboard focus, hover, pressed, and disabled states */
QPushButton#scanButton {
    min-height: 40px;
    background: #63d8c4;
    color: #0b3029;
    border: 2px solid transparent;
    border-radius: 12px;
    padding: 0 18px;
    font-size: 15px;
    font-weight: 700;
}
QPushButton#scanButton:hover { background: #85e8d7; }
QPushButton#scanButton:pressed { background: #45bba8; }
QPushButton#scanButton:focus { border-color: #ffd166; }
QPushButton#scanButton:disabled {
    background: #253c42;
    color: #9cb8bc;
    border-color: #324c53;
}

/* Summary cards and the results container */
QPushButton#metricCard {
    background: #141f2d;
    border: 2px solid #304258;
    border-top: 3px solid #afcaff;
    border-radius: 14px;
    text-align: left;
}
QPushButton#metricCard[tone="warm"] { border-top-color: #f4bc72; }
QPushButton#metricCard[tone="teal"] { border-top-color: #63d8c4; }
QPushButton#metricCard:focus,
QPushButton#metricCard[tone="warm"]:focus,
QPushButton#metricCard[tone="teal"]:focus { border-color: #ffd166; }
QLabel#metricTitle { color: #b2c1d4; font-size: 14px; letter-spacing: 0px; }
QLabel#metricValue { font-size: 34px; font-weight: 600; letter-spacing: -1px; }
QLabel#metricValue[tone="warm"] { color: #f4bc72; }
QLabel#metricValue[tone="teal"] { color: #63d8c4; }

QFrame#resultsPanel {
    background: #111b29;
    border: 1px solid #263346;
    border-radius: 18px;
}
QLabel#sectionTitle { font-size: 18px; font-weight: 600; }

/* Native read-only table. Selection stays visible when focus moves away. */
QTableWidget#incidentTable,
QTableWidget#sourceEventTable {
    background: #121e2c;
    alternate-background-color: #182636;
    color: #e5edf6;
    border: 2px solid #304258;
    border-radius: 10px;
    selection-background-color: #285d6c; selection-color: #ffffff;
    outline: 2px solid #ffd166;
}
QTableWidget#incidentTable:focus,
QTableWidget#sourceEventTable:focus { border-color: #ffd166; }
QTableWidget#incidentTable::item,
QTableWidget#sourceEventTable::item {
    padding: 0 12px;
    border-bottom: 1px solid #243346;
}
QTableWidget#incidentTable::item:hover,
QTableWidget#sourceEventTable::item:hover { background: #22374c; }
QTableWidget#incidentTable::item:selected,
QTableWidget#sourceEventTable::item:selected {
    background: #285d6c;
    color: #ffffff;
}
QTableWidget#incidentTable::item:selected:!active,
QTableWidget#sourceEventTable::item:selected:!active {
    background: #284b60;
    color: #ffffff;
}
QTableWidget#incidentTable::item:selected:hover,
QTableWidget#sourceEventTable::item:selected:hover { background: #326e7d; }
QHeaderView { background: #141f2d; }
QHeaderView::section {
    background: #141f2d;
    color: #cad7e8;
    border: none;
    border-bottom: 1px solid #304258;
    padding: 12px;
    font-size: 14px;
    font-weight: 600;
}
QTableCornerButton::section { background: #141f2d; border: none; }

/* Empty, scanning, and error messages; persistent source information */
QStackedWidget { background: transparent; border: none; }
QLabel#statusLabel { color: #becbdd; font-size: 15px; }
QLabel#scopeLabel { color: #a5b3c6; font-size: 14px; }
QToolTip {
    background: #202f43;
    color: #edf3fa;
    border: 1px solid #4c637b;
    padding: 10px;
    font-size: 15px;
}
QMenu {
    background: #1e2c3e;
    border: 2px solid #71869b;
    padding: 5px;
}
QMenu::item { padding: 8px 20px; }
QMenu::item:selected { background: #285d6c; color: #ffffff; }
QMenu::item:disabled { color: #9baac0; }

QLabel#emptySymbol {
    background: #172e32;
    border: 1px solid #2c514f;
    border-radius: 14px;
    color: #7ce0ce;
    font-size: 19px;
    font-weight: 600;
}
QLabel#emptyTitle { color: #edf3fa; font-size: 24px; font-weight: 700; letter-spacing: -1px; }
QLabel#emptyDescription { color: #a5b3c6; font-size: 15px; }

/* Scrollbars */
QScrollBar:vertical { background: #111b29; width: 16px; margin: 0; }
QScrollBar::handle:vertical {
    background: #71869b;
    min-height: 28px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover { background: #9baac0; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }
QScrollBar:horizontal { background: #111b29; height: 16px; margin: 0; }
QScrollBar::handle:horizontal { background: #71869b; min-width: 28px; border-radius: 4px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

/* Incident detail navigation and read-only content */
QPushButton#secondaryButton {
    background: #1e3043;
    color: #dce8f6;
    border: 2px solid #304258;
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 14px;
    font-weight: 600;
}
QPushButton#secondaryButton:hover { background: #2a4259; border-color: #7294ac; }
QPushButton#secondaryButton:pressed { background: #172737; }
QPushButton#secondaryButton:focus { border-color: #ffd166; }
QPushButton#secondaryButton:disabled {
    color: #94a4ba;
    background: #192636;
    border-color: #2b3c50;
}
QStatusBar QPushButton#secondaryButton { padding: 4px 8px; }
QWidget#incidentDetail, QWidget#detailContent, QScrollArea#detailScroll {
    background: #0d141f;
    border: none;
}
QFrame#detailSection {
    background: #162231;
    border: 1px solid #2b3d51;
    border-radius: 14px;
}
QLabel#detailTitle { color: #edf3fa; font-size: 26px; font-weight: 600; }
QLabel#detailBody { color: #c4d1e1; font-size: 15px; }
QLabel#detailFieldTitle { color: #e5edf6; font-size: 15px; font-weight: 600; }
QLabel#detailScore { color: #80e5d3; font-size: 28px; font-weight: 600; }
QLabel#detailPriority {
    color: #c4d1e1;
    background: #223246;
    border: 1px solid #394e67;
    border-radius: 7px;
    padding: 5px 10px;
    font-weight: 600;
}
QLabel#detailPriority[priority="Critical"] { color: #ffadb7; }
QLabel#detailPriority[priority="High"] { color: #f4bc72; }
QLabel#detailPriority[priority="Medium"] { color: #adcaff; }
QLabel#detailPriority[priority="Low"] { color: #80e5d3; }
QPlainTextEdit#sourceEvents, QPlainTextEdit#diagnosticCommand {
    background: #0f1926;
    color: #d3dfed;
    border: 2px solid #71869b;
    border-radius: 7px;
    padding: 10px;
    selection-background-color: #285d6c; selection-color: #ffffff;
}
QPlainTextEdit#sourceEvents:focus, QPlainTextEdit#diagnosticCommand:focus { border-color: #ffd166; }
QPlainTextEdit#diagnosticCommand { font-family: "Consolas", "Courier New"; font-size: 15px; }
QLabel#diagnosticShell { color: #afcaff; font-size: 14px; font-weight: 600; }
QFrame#diagnosticStep {
    background: #121e2c;
    border: 2px solid #71869b;
    border-radius: 8px;
}
QLabel#diagnosticRisk {
    color: #c4d1e1;
    background: #223246;
    border: 1px solid #394e67;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 14px;
    font-weight: 600;
}
QLabel#diagnosticRisk[risk="safe"] {
    color: #80e5d3; background: #15352f; border-color: #285348;
}
QLabel#diagnosticRisk[risk="caution"] {
    color: #f4bc72; background: #382c20; border-color: #654c30;
}
QLabel#diagnosticRisk[risk="system_change"] {
    color: #ffadb7; background: #3a222d; border-color: #65404e;
}
QTabWidget#detailTabs::pane { border: none; background: #0d141f; }
QTabWidget#detailTabs QTabBar { background: #0d141f; }
QTabWidget#detailTabs QTabBar::tab {
    background: #0d141f;
    color: #a5b3c6;
    border: none;
    border-bottom: 2px solid #263346;
    padding: 12px 20px;
    font-weight: 600;
}
QTabWidget#detailTabs QTabBar::tab:selected {
    color: #80e5d3;
    border-bottom-color: #63d8c4;
}
QTabWidget#detailTabs QTabBar::tab:hover { background: #192636; color: #edf3fa; }
QTabWidget#detailTabs QTabBar::tab:focus { background: #1e3043; }
QProgressBar#scoreContribution {
    background: #29394c;
    border: none;
    border-radius: 3px;
}
QProgressBar#scoreContribution::chunk { background: #63d8c4; border-radius: 3px; }
QWidget#incidentDetail QSplitter::handle { background: #0d141f; }
QWidget#incidentDetail QSplitter::handle:hover { background: #34485f; }

/* Generous controls retain native checkmarks, arrows, and assistive technology roles. */
QPushButton { min-height: 24px; }
QToolButton { min-height: 24px; padding: 5px 8px; border: 2px solid #71869b; }
QToolButton:disabled { background: #192636; color: #8998aa; border-color: #29394c; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit { min-height: 24px; }
QCheckBox, QRadioButton { min-height: 28px; spacing: 9px; padding: 4px; border: 2px solid transparent; }
QCheckBox::indicator, QRadioButton::indicator { width: 22px; height: 22px; }
QCheckBox:focus, QRadioButton:focus { border-color: #ffd166; border-radius: 4px; }
QCheckBox:disabled, QRadioButton:disabled, QLineEdit:disabled, QComboBox:disabled,
QSpinBox:disabled, QDoubleSpinBox:disabled { color: #8998aa; }
QLineEdit:read-only { background: #182636; }
QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QTimeEdit:focus,
QTextEdit:focus, QListView:focus, QTreeView:focus { border: 2px solid #ffd166; }
QPushButton#comparisonButton:focus { border-color: #ffd166; }
QDialog#settingsDialog QCheckBox:focus { border-color: #ffd166; }
QAbstractItemView {
    background: #121e2c; alternate-background-color: #182636; color: #e5edf6;
    border: 2px solid #71869b;
    selection-background-color: #285d6c; selection-color: #ffffff;
}
QTableWidget::item:focus { border: 2px solid #ffd166; }
QMenuBar::item:selected { color: #ffffff; }
QMenu::separator { height: 1px; background: #71869b; margin: 5px; }

/* Use the same clear tab navigation in settings and every secondary dialog. */
QTabWidget::pane { border: 1px solid #71869b; background: #0d141f; }
QTabBar::tab {
    background: #141f2d; color: #c4d1e1;
    border: 2px solid transparent; border-bottom: 3px solid #71869b;
    padding: 10px 14px; min-height: 24px; font-weight: 600;
}
QTabBar::tab:selected { color: #80e5d3; border-bottom-color: #63d8c4; }
QTabBar::tab:hover { background: #192636; }
QTabBar::tab:selected:focus,
QTabWidget#detailTabs QTabBar::tab:selected:focus { border: 2px solid #ffd166; border-bottom: 3px solid #ffd166; }
QSplitter::handle { background: #71869b; }
QScrollBar::handle:horizontal:hover { background: #9baac0; }
QProgressBar { color: #e5edf6; background: #141f2d; border: 1px solid #71869b; text-align: center; }
QProgressBar::chunk { background: #285d6c; }
